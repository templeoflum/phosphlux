# Rust
/target
**/target/
**/*.rs.bk
# Note: Cargo.lock is tracked for reproducible builds (this is a binary, not a library)

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Dependencies (TypeScript archive)
node_modules/

# Build outputs
dist/
dist-demo/

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/

# OS
.DS_Store
Thumbs.db
nul

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# TypeScript cache
*.tsbuildinfo

# Generated test signals (regeneratable)
tools/device-workbench/test_signals/*.png

# Root level temp images (keep docs/screenshots/)
/*.png
/*.jpg
/*.ppm
